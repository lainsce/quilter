; Quilter SUM Theme — faithful port of the original GTK4 styles
@diagnostics: warn
@primary: #667885
@primary-container: #D6DEE5
@surface: #FAFAFA
@surface-dim: #F2F2F2
@sidebar-bg: #F5F5F5
@text: #303030
@muted: #6E7681
@editor-bg: #FFFFFF
@editor-text: #333333

*
  color: @text
  font-size: 14

window
  background: @surface

vstack
hstack
zstack
  background: #ffffff00

; ── AppBar ────────────────────────────────────────────────────
appbar
  background: @surface-dim
  min-height: 46
  padding: 6 10
  color: @text

appbar .iconbtn
  background: @primary-container
  color: @primary
  border-radius: 10

appbar .iconbtn:hover
  background: mix(@primary-container, #ffffff, 30%)

appbar .iconbtn:active
  background: mix(@primary-container, #000000, 8%)
  border-radius: 14

; ── Sidebar ───────────────────────────────────────────────────
vstack.sidebar
  background: @sidebar-bg
  min-width: 200
  max-width: 220

tabs
  background: @sidebar-bg
  font-size: 12
  min-height: 34

list
  background: #ffffff00
  padding: 2

; ── Editor ────────────────────────────────────────────────────
; The original Quilter uses a monospace font with generous padding
; and a clean white background for a distraction-free writing feel.
textview
  background: @editor-bg
  color: @editor-text
  padding: 32 64
  border-radius: 0
  font: "monospace" 16 400
  letter-spacing: 0.3

textview:focus
  border: 0 none #000

; ── Search bar ────────────────────────────────────────────────
searchfield
  background: @surface-dim
  border: 1 solid alpha(@primary, 20%)
  border-radius: 8
  padding: 6 10
  min-height: 32

searchfield:focus
  border: 2 solid @primary

; ── Status bar ────────────────────────────────────────────────
hstack.statusbar
  background: @surface-dim
  min-height: 26

label.statusbar-text
  color: @muted
  font-size: 12

; ── Buttons ───────────────────────────────────────────────────
button
  background: @primary-container
  color: @primary
  border-radius: 10
  min-height: 34
  padding: 6 10

button:hover
  background: mix(@primary-container, #ffffff, 30%)

button:active
  background: mix(@primary-container, #000000, 8%)
  border-radius: 14

button:focus
  border: 2 solid @primary

button.outlined
  background: alpha(@primary, 0%)
  color: @primary
  border: 1 solid alpha(@primary, 25%)

button.outlined:hover
  background: alpha(@primary, 8%)

iconbtn:focus
  border: 2 solid @primary

; ── Scroller ──────────────────────────────────────────────────
scroller
  background: #ffffff00

; ── Tooltip ───────────────────────────────────────────────────
tooltip
  background: @text
  color: #F5F5F5
  border-radius: 8
  padding: 6 8

; ── Dialog ────────────────────────────────────────────────────
dialog
  background: #ffffff
  color: @text
  border-radius: 16
  padding: 20

; ── Dark mode ─────────────────────────────────────────────────
; Matches the original Quilter dark scheme (quilter-dark)
@when dark
  window
    background: #1E1E1E
  appbar
    background: #252525
  vstack.sidebar
    background: #222222
  tabs
    background: #222222
  textview
    background: #1A1A1A
    color: #E0E0E0
  hstack.statusbar
    background: #252525
  label.statusbar-text
    color: #8B8D93
  searchfield
    background: #2A2A2A
    color: #D4D5D9
    border-color: alpha(@primary, 30%)
  dialog
    background: #2A2A2A
    color: #D4D5D9
