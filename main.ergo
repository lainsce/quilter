cask main

bring stdr
bring cogito

-- ============================================================
-- Global widgets
-- ============================================================
def editor = cogito.textview(@"")
def bar = cogito.appbar(@"New Document", @"")
def status_label = cogito.label(@"Words: 0")
def sidebar_list = cogito.list()
def outline_list = cogito.list()
def search_field = cogito.searchfield(@"Find in document…")
def sidebar_views = cogito.view_switcher()

-- ============================================================
-- Global state
-- ============================================================
def ?current_path = @""
def ?suspend_dirty = false
def ?is_dirty = false
def ?show_preview = false
def ?file_paths = []: [string]
def ?file_names = []: [string]
def ?selected_file_index = -1

-- ============================================================
-- Utilities
-- ============================================================
fun is_md_path(path = string) (( bool )) {
    let n = len(path)
    if n < 3 { return false }
    let c1 = path[n - 3]
    let c2 = path[n - 2]
    let c3 = path[n - 1]
    return c1 == @"." && (c2 == @"m" || c2 == @"M") && (c3 == @"d" || c3 == @"D")
}

fun basename(path = string) (( string )) {
    let n = len(path)
    let ?last_sep = -1
    for (let ?i = 0; i < n; i += 1) {
        let ch = path[i]
        if ch == @"/" || ch == @"\\" {
            last_sep = i
        }
    }
    if last_sep < 0 { return path }
    let ?name = @""
    for (let ?i = last_sep + 1; i < n; i += 1) {
        name = @"$name$path[i]"
    }
    return name
}

fun count_words(text = string) (( num )) {
    let n = len(text)
    let ?words = 0
    let ?in_word = false
    for (let ?i = 0; i < n; i += 1) {
        let ch = text[i]
        if ch == @" " || ch == @"\n" || ch == @"\t" || ch == @"\r" {
            if in_word {
                words += 1
                in_word = false
            }
        } else {
            in_word = true
        }
    }
    if in_word { words += 1 }
    return words
}

fun count_sentences(text = string) (( num )) {
    let n = len(text)
    let ?sentences = 0
    for (let ?i = 0; i < n; i += 1) {
        let ch = text[i]
        if ch == @"." || ch == @"!" || ch == @"?" {
            sentences += 1
        }
    }
    return sentences
}

fun reading_time_minutes(words = num) (( num )) {
    -- Average reading speed: 264 WPM (same constant as original Quilter)
    if words <= 0 { return 0 }
    let wpm = 264
    let ?minutes = words / wpm
    if minutes < 1: minutes = 1
    return minutes
}

-- ============================================================
-- UI updates
-- ============================================================
fun update_status() (( -- )) {
    let text = editor.text()
    let words = count_words(text)
    status_label.set_text(@"Words: $words")
}

fun refresh_title() (( -- )) {
    let name = if current_path != @"" { basename(current_path) } else { @"New Document" }
    let title = if is_dirty { @"$name •" } else { name }
    bar.set_title(title)
}

fun set_editor_text(text = string) (( -- )) {
    suspend_dirty = true
    editor.set_text(text)
    suspend_dirty = false
}

-- ============================================================
-- File operations
-- ============================================================
fun new_document() (( -- )) {
    set_editor_text(@"")
    current_path = @""
    is_dirty = false
    refresh_title()
    bar.set_subtitle(@"")
    update_status()
}

fun open_file() (( -- )) {
    let picked = stdr.open_file_dialog(@"Open Markdown", @"md")
    if is_null(picked) { return }
    let path = str(picked)
    let text = stdr.read_text_file(path)
    if is_null(text) {
        bar.set_subtitle(@"Cannot read file")
        return
    }
    set_editor_text(str(text))
    current_path = path
    is_dirty = false
    refresh_title()
    bar.set_subtitle(@"")
    update_status()
}

fun save_file() (( -- )) {
    if current_path == @"" {
        save_file_as()
        return
    }
    let ok = stdr.write_text_file(current_path, editor.text())
    if !ok {
        bar.set_subtitle(@"Save failed")
    } else {
        is_dirty = false
        refresh_title()
        bar.set_subtitle(@"Saved")
    }
}

fun save_file_as() (( -- )) {
    let default_name = if current_path == @"" { @"Untitled.md" } else { basename(current_path) }
    let picked = stdr.save_file_dialog(@"Save As", default_name, @"md")
    if is_null(picked) { return }
    let ?path = str(picked)
    if !is_md_path(path) {
        path = @"$path.md"
    }
    let ok = stdr.write_text_file(path, editor.text())
    if !ok {
        bar.set_subtitle(@"Save failed")
    } else {
        current_path = path
        is_dirty = false
        refresh_title()
        bar.set_subtitle(@"Saved")
    }
}

-- ============================================================
-- Build UI — mirrors the original Vala layout:
--   ┌─────────────────────────────────────────────┐
--   │  AppBar  [≡ title ▼]  [doc ☰] [preview ⊞]  │
--   ├──────────┬──────────────────────────────────┤
--   │ Sidebar  │  SearchBar (revealable)          │
--   │ ┌──────┐ │  ┌──────────────────────────────┐│
--   │ │Files │ │  │                              ││
--   │ │------│ │  │     Editor (SourceView)       ││
--   │ │ doc1 │ │  │                              ││
--   │ │ doc2 │ │  │                              ││
--   │ │      │ │  └──────────────────────────────┘│
--   │ │------│ │         ┌───────────────────┐    │
--   │ │Outln │ │         │ Words: 123        │    │
--   │ └──────┘ │         └───────────────────┘    │
--   └──────────┴──────────────────────────────────┘
-- ============================================================
fun build_ui(win = cogito.Window) (( -- )) {
    let root = cogito.vstack()
    root.set_gap(0)
    root.set_hexpand(true)
    root.set_vexpand(true)

    -- ── AppBar ──────────────────────────────────────────────
    bar.set_title(@"New Document")
    bar.set_subtitle(@"")
    bar.set_hexpand(true)

    -- Document operations button (menu)
    let doc_btn = bar.add_button(@"sf:doc.text", (b = cogito.Button) => {})
    doc_btn.add_menu(@"New File", (b = cogito.Button) => { new_document() })
    doc_btn.add_menu(@"Open…", (b = cogito.Button) => { open_file() })
    doc_btn.add_menu(@"Save", (b = cogito.Button) => { save_file() })
    doc_btn.add_menu(@"Save As…", (b = cogito.Button) => { save_file_as() })
    cogito.set_tooltip(doc_btn, @"Document")

    root.add(bar)

    -- ── Main area (sidebar + content) ───────────────────────
    let main_area = cogito.hstack()
    main_area.set_hexpand(true)
    main_area.set_vexpand(true)
    main_area.set_gap(0)

    -- ── Sidebar ─────────────────────────────────────────────
    let sidebar = cogito.vstack()
    cogito.set_class(sidebar, @"sidebar")
    sidebar.set_vexpand(true)

    -- Sidebar tabs: Files / Outline
    let sidebar_tabs = cogito.tabs()
    sidebar_tabs.set_items([@"Files", @"Outline"])
    sidebar_tabs.set_ids([@"files", @"outline"])
    sidebar_tabs.set_selected(0)
    sidebar_tabs.set_hexpand(true)
    sidebar.add(sidebar_tabs)

    -- Files view
    let files_view = cogito.vstack()
    cogito.set_id(files_view, @"files")
    files_view.set_vexpand(true)
    files_view.set_hexpand(true)

    let files_scroller = cogito.scroller()
    files_scroller.set_axes(false, true)
    files_scroller.set_vexpand(true)

    sidebar_list.set_vexpand(true)
    sidebar_list.set_hexpand(true)
    sidebar_list.add(cogito.label(@"New Document"))
    sidebar_list.on_select((idx) => {
        selected_file_index = idx
    })
    files_scroller.add(sidebar_list)
    files_view.add(files_scroller)

    -- Outline view
    let outline_view = cogito.vstack()
    cogito.set_id(outline_view, @"outline")
    outline_view.set_vexpand(true)
    outline_view.set_hexpand(true)

    let outline_scroller = cogito.scroller()
    outline_scroller.set_axes(false, true)
    outline_scroller.set_vexpand(true)

    outline_list.set_vexpand(true)
    outline_list.set_hexpand(true)
    outline_scroller.add(outline_list)
    outline_view.add(outline_scroller)

    -- Wire tabs ↔ views
    sidebar_views.set_hexpand(true)
    sidebar_views.set_vexpand(true)
    sidebar_views.add(files_view)
    sidebar_views.add(outline_view)
    sidebar_tabs.bind(sidebar_views)
    sidebar.add(sidebar_views)

    main_area.add(sidebar)

    -- ── Editor content area ─────────────────────────────────
    let content = cogito.vstack()
    content.set_hexpand(true)
    content.set_vexpand(true)
    content.set_gap(0)

    -- Search bar
    search_field.set_hexpand(true)
    search_field.on_change((s = cogito.SearchField) => {
        let query = s.text()
        if query != @"" {
            bar.set_subtitle(@"Searching: $query")
        } else {
            bar.set_subtitle(@"")
        }
    })
    content.add(search_field)

    -- Editor
    editor.set_hexpand(true)
    editor.set_vexpand(true)
    editor.on_change((tv = cogito.TextView) => {
        if !suspend_dirty {
            is_dirty = true
            refresh_title()
            update_status()
        }
    })
    content.add(editor)

    -- Status bar
    let status_bar = cogito.hstack()
    cogito.set_class(status_bar, @"statusbar")
    status_bar.set_hexpand(true)
    status_bar.set_padding(12, 4, 12, 4)

    status_label.set_text(@"Words: 0")
    cogito.set_class(status_label, @"statusbar-text")
    status_label.set_hexpand(true)
    status_bar.add(status_label)
    content.add(status_bar)

    main_area.add(content)
    root.add(main_area)
    win.add(root)

    -- Initialize state
    refresh_title()
    update_status()
}

-- ============================================================
-- Entry point
-- ============================================================
entry() (( -- )) {
    cogito.load_sum(@"quilter.sum")

    let app = cogito.app()
    app.set_appid(@"io.github.lainsce.Quilter")
    app.set_app_name(@"Quilter")
    app.set_accent_color(@"#667885", false)

    let win = cogito.window_size(@"Quilter", 1100, 700)
    win.set_autosize(false)
    win.set_resizable(true)
    win.set_a11y_label(@"Quilter Markdown Editor")
    win.build(build_ui)

    app.run(win)
}
